<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>com.sithum.wallet</groupId>
    <artifactId>wallet-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>wallet-parent</name>

    <modules>
        <module>wallet-core</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-modulith.version>1.4.0</spring-modulith.version>
        <!-- Docker Engine 29 requires API >= 1.40; Testcontainers 1.21.0 is too old for it -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- SonarQube Cloud (ADR-0005). Identifiers only, no secrets: the token is the SONAR_TOKEN env var. -->
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.organization>vivid-pay</sonar.organization>
        <sonar.projectKey>vivid-pay_wallet-service</sonar.projectKey>
        <sonar.projectName>wallet-service</sonar.projectName>
        <!-- Config classes and the application entry point are excluded from coverage, not from analysis. -->
        <sonar.coverage.exclusions>**/WalletApplication.java,**/*Config.java,**/*Configuration.java,**/config/**</sonar.coverage.exclusions>
        <!-- The JaCoCo report written by wallet-core's `verify` (VPAY-12). -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>5.1.0.4751</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
